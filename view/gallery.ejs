<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gallery | Dipanshu Ambilkar</title>
  <meta name="description" content="Moments from prototypes, events, and travel — a visual record by Dipanshu Ambilkar.">
  <meta name="theme-color" content="#0b0a0d">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/gallery.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="hero__nav">
    <a href="/" class="hero__logo" aria-label="Dipanshu Ambilkar home">
      <span class="hero__logo-mark" aria-hidden="true">DA</span>
      <span class="hero__logo-text">Dipanshu <em>Ambilkar</em></span>
    </a>
    <button class="hero__menu-toggle" aria-label="Toggle navigation" aria-controls="primary-navigation" aria-expanded="false" type="button">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav class="hero__menu" id="primary-navigation" aria-label="Primary">
      <a href="/">Home</a>
      <a href="/projects">Projects</a>
      <a href="/#skills">Skills</a>
      <a href="/#leetcode">Java</a>
      <a href="/resume">Resume</a>
      <a href="/#journey">Journey</a>
      <a href="/gallery" class="is-active">Gallery</a>
      <a href="/certificate">Certificates</a>
      <a href="/#contact" class="nav-cta">Contact</a>
    </nav>
  </header>

  <main class="gallery-shell" id="main-content">
    <div class="gallery-hero">
      <p class="gallery-kicker">Visual Stories</p>
      <h1>Gallery</h1>
      <p>Moments from prototypes, events, travel, and the quiet parts of building things.</p>
    </div>

    <div class="gallery-grid">
      <% if (fallback) { %>
        <p class="gallery-note">A curated set of moments from the archive — prototypes, events, and travel while the full gallery syncs.</p>
      <% } %>
      <% if (images && images.length) { %>
        <% images.forEach((image, index) => {
          const caption = image.caption || `Gallery image ${index + 1}`;
          const imageSrc = image.imageUrl || (/^https?:\/\//.test(image.filename) || String(image.filename).startsWith('/') ? image.filename : `/image/gallery/${image.filename}`);
        %>
          <article class="image-card">
            <img src="<%= imageSrc %>" alt="<%= caption %>" loading="lazy" decoding="async">
            <p><%= caption %></p>
          </article>
        <% }); %>
      <% } else { %>
        <article class="gallery-empty">
          <h2>Gallery is syncing.</h2>
          <p>Images will appear here after the gallery database is available.</p>
        </article>
      <% } %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <a href="/" class="hero__logo" aria-label="Dipanshu Ambilkar home">
          <span class="hero__logo-mark" aria-hidden="true">DA</span>
          <span class="hero__logo-text">Dipanshu <em>Ambilkar</em></span>
        </a>
        <p>Full-stack, AI, and IoT work built with curiosity, research, and a bias for shipping.</p>
        <div class="site-footer__socials">
          <a href="https://github.com/dipanshuAmbilkar03/" target="_blank" rel="noopener noreferrer" aria-label="GitHub">GH</a>
          <a href="https://www.linkedin.com/in/dipanshuambilkar/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">IN</a>
          <a href="https://leetcode.com/u/dipanshu0312/" target="_blank" rel="noopener noreferrer" aria-label="LeetCode">LC</a>
          <a href="https://www.kaggle.com/onyxstrangler" target="_blank" rel="noopener noreferrer" aria-label="Kaggle">KG</a>
        </div>
      </div>
      <nav class="site-footer__nav" aria-label="Footer">
        <a href="/projects">Projects</a>
        <a href="/#skills">Skills</a>
        <a href="/#journey">Journey</a>
        <a href="/resume">Resume</a>
        <a href="/gallery">Gallery</a>
        <a href="/certificate">Certificates</a>
      </nav>
      <div class="site-footer__meta">
        <a href="mailto:dipanshuambilkar@gmail.com">dipanshuambilkar@gmail.com</a>
        <span>Pune, Maharashtra · India</span>
        <p>© 2026 Dipanshu Ambilkar<br>Designed &amp; built with intent.</p>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const menuToggle = document.querySelector('.hero__menu-toggle');
      const navMenu = document.querySelector('.hero__menu');
      const mobileViewport = window.matchMedia('(max-width: 639px)');

      if (!menuToggle || !navMenu) return;

      const setMenuState = (isOpen) => {
        navMenu.classList.toggle('is-open', isOpen);
        menuToggle.classList.toggle('is-open', isOpen);
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        document.body.classList.toggle('menu-open', isOpen && mobileViewport.matches);
      };

      menuToggle.addEventListener('click', () => {
        setMenuState(!navMenu.classList.contains('is-open'));
      });

      navMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuState(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuState(false);
      });

      mobileViewport.addEventListener('change', () => {
        if (!mobileViewport.matches) setMenuState(false);
      });
    });
  </script>
</body>
</html>
